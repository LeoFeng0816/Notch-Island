"CFBundleDisplayName" = "Notch Island";
"NSAppleEventsUsageDescription" = "Notch Island reads playback from supported music apps and YouTube tabs, sends playback commands, and—only when you choose it—asks QuickTime Player to open its screen-recording toolbar.";
"NSLocationUsageDescription" = "Notch Island uses an approximate location to show local weather when requested.";
"NSLocationWhenInUseUsageDescription" = "Notch Island uses an approximate location to show local weather when requested.";
"NSCalendarsFullAccessUsageDescription" = "Notch Island reads your calendar events to show upcoming events in the calendar widget.";
"NSAudioCaptureUsageDescription" = "Notch Island uses this Mac’s audio for live levels when enabled and, after you press Music Recognition, to identify music: by default about 12 seconds are uploaded to Song Finder (songfinder.dev), a third-party service, after you agree; Shazam sends audio signatures to Apple; AudD, only if you choose it, receives up to 10 seconds.";
"NSMicrophoneUsageDescription" = "Notch Island uses the microphone only after you press Music Recognition: by default about 12 seconds are uploaded to Song Finder (songfinder.dev), a third-party service, after you agree; with Shazam up to 30 seconds (not stored); or—only if you choose AudD—up to 10 seconds uploaded to AudD.";
